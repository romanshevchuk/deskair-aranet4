<UserControl x:Class="Deskair.App.Ui.Views.Gallery.BatteryIconSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_BatteryIcon}" />
    <WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon Percent="100" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="100 %" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon Percent="65" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="65 %" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon Percent="20" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="20 %" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon Percent="10" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="10 %" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon Percent="1" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="1 %" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource Space.Item}">
        <controls:BatteryIcon />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="{loc:T Chart_NoData}" />
      </StackPanel>
    </WrapPanel>
  </StackPanel>
</UserControl>
