<UserControl x:Class="Deskair.App.Ui.Views.Gallery.PillSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:zones="clr-namespace:Deskair.Domain.Zones;assembly=Deskair.Domain">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_Pill}" />
    <WrapPanel>
      <controls:Pill Margin="{StaticResource Space.Item}" Content="{loc:T Chart_NoData}" />
      <controls:Pill Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.Good}" Content="{loc:T Zone_Good}" />
      <controls:Pill Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.Elevated}" Content="{loc:T Zone_Elevated}" />
      <controls:Pill Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.High}" Content="{loc:T Zone_High}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
