<UserControl x:Class="Deskair.App.Ui.Views.Gallery.StatTripleSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:zones="clr-namespace:Deskair.Domain.Zones;assembly=Deskair.Domain">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_StatTriple}" />
    <WrapPanel>
      <controls:StatTriple Width="340" Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.Good}">
        <controls:KeyValueCell ValueFirst="True" Value="71%" Label="{loc:T Stat_GoodShare}" />
        <controls:KeyValueCell ValueFirst="True" Value="1,486 ppm" Label="{loc:T Gallery_Sample_Peak}" />
        <controls:KeyValueCell ValueFirst="True" Value="2 h 05" Label="{loc:T Gallery_Sample_InZone}" />
      </controls:StatTriple>
      <controls:StatTriple Width="340" Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.Elevated}">
        <controls:KeyValueCell ValueFirst="True" Value="28%" Label="{loc:T Stat_GoodShare}" />
        <controls:KeyValueCell ValueFirst="True" Value="2,081 ppm" Label="{loc:T Gallery_Sample_Peak}" />
        <controls:KeyValueCell ValueFirst="True" Value="38 min" Label="{loc:T Gallery_Sample_InZone}" />
      </controls:StatTriple>
      <controls:StatTriple Width="340" Margin="{StaticResource Space.Item}" Zone="{x:Static zones:Zone.High}">
        <controls:KeyValueCell ValueFirst="True" Value="9%" Label="{loc:T Stat_GoodShare}" />
        <controls:KeyValueCell ValueFirst="True" Value="1,732 ppm" Label="{loc:T Gallery_Sample_Peak}" />
      </controls:StatTriple>
      <controls:StatTriple Width="340" Margin="{StaticResource Space.Item}">
        <controls:KeyValueCell Value="71%" Label="{loc:T Stat_GoodShare}" />
        <controls:KeyValueCell Value="1,486 ppm" Label="{loc:T Gallery_Sample_Peak}" />
        <controls:KeyValueCell Label="{loc:T Gallery_Sample_InZone}" />
      </controls:StatTriple>
    </WrapPanel>
  </StackPanel>
</UserControl>
