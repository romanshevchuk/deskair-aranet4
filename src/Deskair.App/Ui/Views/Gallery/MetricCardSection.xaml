<UserControl x:Class="Deskair.App.Ui.Views.Gallery.MetricCardSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:gallery="clr-namespace:Deskair.App.Ui.Views.Gallery"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:metrics="clr-namespace:Deskair.Domain.Metrics;assembly=Deskair.Domain">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_MetricCard}" />
    <WrapPanel>
      <controls:MetricCard Width="380" Height="{StaticResource Size.Live.MiniRow.Height}" Margin="{StaticResource Space.Item}"
                           Metric="{x:Static metrics:Metric.Temperature}" Title="{loc:T Metric_Temperature}"
                           Value="22.3" Unit="°C" Subtitle="{loc:T Trend_Steady}">
        <charts:Sparkline Width="{StaticResource Size.Mini.Sparkline.Width}" Height="{StaticResource Size.Mini.Sparkline.Height}" Metric="Temperature" Points="{x:Static gallery:GallerySamples.Temperature}" />
      </controls:MetricCard>
      <controls:MetricCard Width="380" Height="{StaticResource Size.Live.MiniRow.Height}" Margin="{StaticResource Space.Item}"
                           Metric="{x:Static metrics:Metric.Humidity}" Title="{loc:T Metric_Humidity}"
                           Value="44" Unit="%" Subtitle="{loc:T Trend_Falling}" IsSelected="True">
        <charts:Sparkline Width="{StaticResource Size.Mini.Sparkline.Width}" Height="{StaticResource Size.Mini.Sparkline.Height}" Metric="Humidity" Points="{x:Static gallery:GallerySamples.Humidity}" />
      </controls:MetricCard>
      <controls:MetricCard Width="380" Height="{StaticResource Size.Live.MiniRow.Height}" Margin="{StaticResource Space.Item}"
                           Metric="{x:Static metrics:Metric.Pressure}" Title="{loc:T Metric_Pressure}"
                           Value="975.3" Unit="hPa" Subtitle="{loc:T Trend_Rising}">
        <charts:Sparkline Width="{StaticResource Size.Mini.Sparkline.Width}" Height="{StaticResource Size.Mini.Sparkline.Height}" Metric="Pressure" Points="{x:Static gallery:GallerySamples.Pressure}" />
      </controls:MetricCard>
      <controls:MetricCard Width="380" Height="{StaticResource Size.Live.MiniRow.Height}" Margin="{StaticResource Space.Item}"
                           Metric="{x:Static metrics:Metric.Co2}" Title="{loc:T Metric_Co2}"
                           Unit="ppm" Subtitle="{loc:T Chart_NoData}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
