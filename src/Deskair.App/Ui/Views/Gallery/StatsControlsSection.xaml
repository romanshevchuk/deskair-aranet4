<UserControl x:Class="Deskair.App.Ui.Views.Gallery.StatsControlsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_CoverageChip}" />
    <WrapPanel>
      <controls:CoverageChip Margin="{StaticResource Space.Item}" Fraction="0.82" />
      <controls:CoverageChip Margin="{StaticResource Space.Item}" Fraction="0.35" />
      <controls:CoverageChip Margin="{StaticResource Space.Item}" Fraction="{x:Null}" />
    </WrapPanel>

    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_ZoneShareBar}" />
    <StackPanel Width="360" HorizontalAlignment="Left">
      <controls:ZoneShareBar Margin="{StaticResource Space.Item}" Good="0.62" Elevated="0.28" High="0.10" />
      <controls:ZoneShareBar Margin="{StaticResource Space.Item}" Good="0.30" Elevated="0.20" High="0.05" />
      <controls:ZoneShareBar Margin="{StaticResource Space.Item}" Good="0" Elevated="0" High="0" />
      <controls:ZoneShareBar Margin="{StaticResource Space.Item}" Good="1" Elevated="0" High="0" />
    </StackPanel>

    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_InsightBox}" />
    <controls:InsightBox Width="360" HorizontalAlignment="Left"
                         Margin="{StaticResource Space.Item}"
                         Content="{loc:T Gallery_Sample_Insight}" />
  </StackPanel>
</UserControl>
