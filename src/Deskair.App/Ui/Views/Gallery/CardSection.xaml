<UserControl x:Class="Deskair.App.Ui.Views.Gallery.CardSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:zones="clr-namespace:Deskair.Domain.Zones;assembly=Deskair.Domain">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_Card}" />
    <WrapPanel>
      <controls:Card Margin="{StaticResource Space.Item}" Padding="{StaticResource Space.Card.Padding}">
        <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Gallery_Sample_CardText}" />
      </controls:Card>
      <controls:Card Margin="{StaticResource Space.Item}" Padding="{StaticResource Space.Card.Padding}" Zone="{x:Static zones:Zone.Good}">
        <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Zone_Good}" />
      </controls:Card>
      <controls:Card Margin="{StaticResource Space.Item}" Padding="{StaticResource Space.Card.Padding}" Zone="{x:Static zones:Zone.Elevated}">
        <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Zone_Elevated}" />
      </controls:Card>
      <controls:Card Margin="{StaticResource Space.Item}" Padding="{StaticResource Space.Card.Padding}" Zone="{x:Static zones:Zone.High}">
        <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Zone_High}" />
      </controls:Card>
    </WrapPanel>
  </StackPanel>
</UserControl>
