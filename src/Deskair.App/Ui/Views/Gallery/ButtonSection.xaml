<UserControl x:Class="Deskair.App.Ui.Views.Gallery.ButtonSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_Button}" />
    <WrapPanel>
      <controls:PrimaryButton Margin="{StaticResource Space.Item}" Content="{loc:T Gallery_Sample_Primary}" />
      <controls:PrimaryButton Margin="{StaticResource Space.Item}" IsEnabled="False" Content="{loc:T Gallery_Sample_Disabled}" />
      <controls:SecondaryButton Margin="{StaticResource Space.Item}" Content="{loc:T Gallery_Sample_Secondary}" />
      <controls:SecondaryButton Margin="{StaticResource Space.Item}" IsEnabled="False" Content="{loc:T Gallery_Sample_Disabled}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
