<UserControl x:Class="Deskair.App.Ui.Views.Gallery.StatusDotSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:zones="clr-namespace:Deskair.Domain.Zones;assembly=Deskair.Domain">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_StatusDot}" />
    <WrapPanel>
      <StackPanel Margin="{StaticResource Space.Item}" Orientation="Horizontal">
        <controls:StatusDot VerticalAlignment="Center" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="{loc:T Chart_NoData}" />
      </StackPanel>
      <StackPanel Margin="{StaticResource Space.Item}" Orientation="Horizontal">
        <controls:StatusDot VerticalAlignment="Center" Zone="{x:Static zones:Zone.Good}" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="{loc:T Zone_Good}" />
      </StackPanel>
      <StackPanel Margin="{StaticResource Space.Item}" Orientation="Horizontal">
        <controls:StatusDot VerticalAlignment="Center" Zone="{x:Static zones:Zone.Elevated}" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="{loc:T Zone_Elevated}" />
      </StackPanel>
      <StackPanel Margin="{StaticResource Space.Item}" Orientation="Horizontal">
        <controls:StatusDot VerticalAlignment="Center" Zone="{x:Static zones:Zone.High}" />
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Text.Secondary}" Text="{loc:T Zone_High}" />
      </StackPanel>
    </WrapPanel>
  </StackPanel>
</UserControl>
