<UserControl x:Class="Deskair.App.Ui.Views.Gallery.ToggleSwitchSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <StackPanel>
    <TextBlock Margin="{StaticResource Space.SectionLabel}"
               Style="{StaticResource Text.SectionLabel}"
               Text="{loc:T Gallery_Section_ToggleSwitch}" />
    <WrapPanel>
      <controls:ToggleSwitch Margin="{StaticResource Space.Item}"
                             AutomationProperties.Name="{loc:T Settings_Alerts}"
                             Content="{loc:T Settings_Alerts}" />
      <controls:ToggleSwitch Margin="{StaticResource Space.Item}"
                             IsChecked="True"
                             AutomationProperties.Name="{loc:T Settings_Alerts}"
                             Content="{loc:T Settings_Alerts}" />
      <controls:ToggleSwitch Margin="{StaticResource Space.Item}"
                             IsEnabled="False"
                             AutomationProperties.Name="{loc:T Gallery_Sample_Disabled}"
                             Content="{loc:T Gallery_Sample_Disabled}" />
      <controls:ToggleSwitch Margin="{StaticResource Space.Item}"
                             IsEnabled="False"
                             IsChecked="True"
                             AutomationProperties.Name="{loc:T Gallery_Sample_Disabled}"
                             Content="{loc:T Gallery_Sample_Disabled}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
