<UserControl x:Class="Deskair.App.Ui.Views.Onboarding.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:local="clr-namespace:Deskair.App.Ui.Views.Onboarding"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: OnboardingViewModel. First run: the welcome card with the steps on the left; the sensors found nearby and the room name on the right. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="{StaticResource Grid.Card.Gap}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <local:WelcomeCard Grid.Column="0" VerticalAlignment="Top" />

    <StackPanel Grid.Column="2">
      <controls:SettingsCard Margin="0,0,0,16" Header="{loc:T Onboarding_Nearby_Title}">
        <StackPanel>
          <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding NearbySensors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:SettingsRow Header="{Binding Name}" Description="{Binding Detail}">
                  <controls:PrimaryButton Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType={x:Type local:OnboardingView}}}"
                                          CommandParameter="{Binding}"
                                          Content="{loc:T Onboarding_Pair}" />
                </controls:SettingsRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <controls:SettingsRow Header="{loc:T Onboarding_Searching}"
                                Visibility="{Binding ShowSearching, Converter={StaticResource BoolToVisibility}}" />
          <controls:SettingsRow Header="{loc:T Onboarding_NoSensor}"
                                Visibility="{Binding ShowNoSensor, Converter={StaticResource BoolToVisibility}}">
            <controls:SecondaryButton Command="{Binding RetryCommand}" Content="{loc:T Action_Retry}" />
          </controls:SettingsRow>
          <controls:SettingsRow Header="{loc:T Onboarding_BluetoothOff}"
                                Visibility="{Binding ShowBluetoothOff, Converter={StaticResource BoolToVisibility}}">
            <controls:SecondaryButton Command="{Binding RetryCommand}" Content="{loc:T Action_Retry}" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:T Onboarding_Room_Title}">
        <controls:SettingsRow Header="{loc:T Onboarding_Room_Name}" Description="{loc:T Onboarding_Room_NameHint}">
          <controls:TextInput AutomationProperties.Name="{loc:T Onboarding_Room_Name}"
                              Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow>
      </controls:SettingsCard>

      <TextBlock Margin="{StaticResource Space.Onboarding.Message}"
                 Foreground="{DynamicResource Zone.High.PillText.Brush}"
                 Style="{StaticResource Text.Secondary}"
                 Text="{loc:T Onboarding_PairFailed}"
                 TextWrapping="Wrap"
                 Visibility="{Binding PairFailed, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </Grid>
</UserControl>
