<UserControl x:Class="Deskair.App.Ui.Views.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:history="clr-namespace:Deskair.App.Ui.Views.History"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:states="clr-namespace:Deskair.App.Ui.Views.States">
  <!-- DataContext: HistoryViewModel. The toolbar on top; below it the main chart and the typical day (or the sleep card, for Day plus Night) on the left and the stats card (360 px) on the right.
       While nothing is stored for the room, "collecting your first data" takes the place of all of it. -->
  <UserControl.Resources>
    <Style x:Key="History.Content" TargetType="{x:Type Grid}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="History.Chart" TargetType="{x:Type charts:HistoryChart}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowGrid}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="History.Grid" TargetType="{x:Type charts:HourGridChart}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowGrid}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="History.Readout" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="Text" Value="{Binding Hover.Text, ElementName=Chart}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowGrid}" Value="True">
          <Setter Property="Text" Value="{Binding Hover.Text, ElementName=HourGrid}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A period before the first reading (D-0019): the cards give way to "No readings for …" with "Go to the latest". -->
    <Style x:Key="History.Cards" TargetType="{x:Type Grid}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPeriodEmpty}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="History.PeriodEmpty" TargetType="{x:Type controls:EmptyStateCard}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPeriodEmpty}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="History.Empty" TargetType="{x:Type states:EmptyHistoryView}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Command="{Binding Toolbar.PreviousPeriodCommand}" Gesture="Alt+Left" />
    <KeyBinding Command="{Binding Toolbar.NextPeriodCommand}" Gesture="Alt+Right" />
  </UserControl.InputBindings>

  <Grid>
    <Grid Style="{StaticResource History.Content}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <history:HistoryToolbar Grid.Row="0"
                              Margin="0,0,0,12"
                              DataContext="{Binding Toolbar}"
                              ExportCommand="{Binding DataContext.Export.ExportCommand, RelativeSource={RelativeSource AncestorType={x:Type history:HistoryView}}}"
                              ExportStatus="{Binding DataContext.Export.StatusText, RelativeSource={RelativeSource AncestorType={x:Type history:HistoryView}}}" />

      <controls:EmptyStateCard Grid.Row="1"
                               VerticalAlignment="Top"
                               Icon="&#xE787;"
                               Message="{Binding PeriodEmptyText}"
                               Style="{StaticResource History.PeriodEmpty}"
                               Title="{Binding PeriodEmptyTitle}">
        <controls:SecondaryButton Command="{Binding Toolbar.LatestCommand}" Content="{loc:T History_Period_Latest}" />
      </controls:EmptyStateCard>

      <Grid Grid.Row="1" Style="{StaticResource History.Cards}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{StaticResource Grid.Card.Gap}" />
          <ColumnDefinition Width="{StaticResource Grid.History.Stats.Width}" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <controls:Card Grid.Row="0" Padding="{StaticResource Space.History.Chart.Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <history:ChartHeader Grid.Row="0" Margin="0,0,0,6" DataContext="{Binding ChartHeader}" />

              <charts:HistoryChart x:Name="Chart"
                                   AutomationProperties.Name="{Binding ChartName}"
                                   Grid.Row="1"
                                   ComfortBand="{Binding ComfortBand}"
                                   Gaps="{Binding Gaps}"
                                   Highlight="{Binding Highlight}"
                                   Metric="{Binding Toolbar.Metric}"
                                   NoDataText="{loc:T Chart_NoData}"
                                   Markers="{Binding Markers}"
                                   NightLabel="{loc:T History_Legend_Night}"
                                   NightSpans="{Binding NightSpans}"
                                   Points="{Binding Points}"
                                   Style="{StaticResource History.Chart}"
                                   TypicalHoverText="{loc:T History_Hover_Typical}"
                                   TypicalPoints="{Binding TypicalPoints}"
                                   Unit="{Binding Stats.UnitText}" />

              <!-- D-0018: CO₂ on Week and Month is the days × hours grid; it takes the bars' place. -->
              <charts:HourGridChart x:Name="HourGrid"
                                    Grid.Row="1"
                                    AutomationProperties.Name="{Binding GridName}"
                                    Model="{Binding Grid}"
                                    Style="{StaticResource History.Grid}" />

              <!-- What the mouse or the keyboard points at; announced as it changes. -->
              <TextBlock Grid.Row="2"
                         Margin="{StaticResource Space.Chart.Caption}"
                         MinHeight="{StaticResource Size.Chart.Readout.Height}"
                         AutomationProperties.LiveSetting="Polite"
                         Style="{StaticResource History.Readout}" />
            </Grid>
          </controls:Card>

        </Grid>

        <!-- The two cards can be taller than the window at its smallest size, so the column scrolls; the margins keep the card shadows from being cut off. -->
        <ScrollViewer Grid.Column="2" Margin="-6,0,-6,0" VerticalScrollBarVisibility="Auto">
          <history:SummaryCard Margin="6,0,6,10" VerticalAlignment="Top" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <states:EmptyHistoryView Style="{StaticResource History.Empty}" />
  </Grid>
</UserControl>
