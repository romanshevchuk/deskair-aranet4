<UserControl x:Class="Deskair.App.Ui.Views.History.HistoryToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
              xmlns:metrics="clr-namespace:Deskair.Domain.Metrics;assembly=Deskair.Domain"
             xmlns:time="clr-namespace:Deskair.Domain.Time;assembly=Deskair.Domain">
  <!-- DataContext: HistoryToolbarViewModel. Metric on the left; the period (‹ title ›), hours, range and Export on the right. There is no Group by (D-0019): Month shows days and Year weeks.
       Export saves every stored reading of the room as CSV (ExportCommand comes from the screen). -->
  <Grid Height="{StaticResource Size.History.Toolbar.Height}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <controls:SegmentedControl Grid.Column="0"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{loc:T Toolbar_Metric}"
                               SelectedValue="{Binding Metric, Mode=TwoWay}"
                               SelectedValuePath="Tag">
      <ListBoxItem Tag="{x:Static metrics:Metric.Co2}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Metric.Co2.Brush}" />
          <TextBlock Text="{loc:T Metric_Co2}" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Tag="{x:Static metrics:Metric.Temperature}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Metric.Temperature.Brush}" />
          <TextBlock Text="{loc:T Metric_Temperature}" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Tag="{x:Static metrics:Metric.Humidity}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Metric.Humidity.Brush}" />
          <TextBlock Text="{loc:T Metric_Humidity}" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Tag="{x:Static metrics:Metric.Pressure}">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Metric.Pressure.Brush}" />
          <TextBlock Text="{loc:T Metric_Pressure}" />
        </StackPanel>
      </ListBoxItem>
    </controls:SegmentedControl>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- The period (D-0019): ‹ title ›. The title is announced when it changes; Alt+← and Alt+→ do the same as the arrows (HistoryView). -->
      <StackPanel Margin="{StaticResource Space.History.Navigator}" Orientation="Horizontal">
        <controls:IconButton AutomationProperties.Name="{loc:T History_Period_Previous}"
                             Command="{Binding PreviousPeriodCommand}"
                             Glyph="&#xE76B;"
                             ToolTip="{loc:T History_Period_Previous}" />
        <TextBlock MinWidth="{StaticResource Size.History.Navigator.Title}"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"
                   FontFamily="{DynamicResource Font.Family.Display}"
                   FontSize="{DynamicResource Font.Size.Title}"
                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Text.Primary.Brush}"
                   Text="{Binding PeriodLabel}"
                   TextAlignment="Center" />
        <controls:IconButton AutomationProperties.Name="{loc:T History_Period_Next}"
                             Command="{Binding NextPeriodCommand}"
                             Glyph="&#xE76C;"
                             ToolTip="{loc:T History_Period_Next}" />
      </StackPanel>

      <controls:SegmentedControl Margin="{StaticResource Space.Inline}"
                                 AutomationProperties.Name="{loc:T Toolbar_Range}"
                                 SelectedValue="{Binding Range, Mode=TwoWay}"
                                 SelectedValuePath="Tag">
        <ListBoxItem Content="{loc:T Range_Day}" Tag="{x:Static time:Period.Day}" />
        <ListBoxItem Content="{loc:T Range_Week}" Tag="{x:Static time:Period.Week}" />
        <ListBoxItem Content="{loc:T Range_Month}" Tag="{x:Static time:Period.Month}" />
        <ListBoxItem Content="{loc:T Range_Year}" Tag="{x:Static time:Period.Year}" />
      </controls:SegmentedControl>

      <TextBlock MaxWidth="{StaticResource Size.History.Export.StatusWidth}"
                 Margin="{StaticResource Space.Inline.Wide}"
                 VerticalAlignment="Center"
                 Text="{Binding ExportStatus, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                 TextTrimming="CharacterEllipsis">
        <TextBlock.Style>
          <Style BasedOn="{StaticResource Text.Secondary}" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <controls:IconButton Margin="{StaticResource Space.Inline}"
                           AutomationProperties.Name="{loc:T Action_Export}"
                           Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                           Glyph="&#xE896;"
                           ToolTip="{loc:T Action_Export}" />
    </StackPanel>
  </Grid>
</UserControl>
