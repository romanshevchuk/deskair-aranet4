<UserControl x:Class="Deskair.App.Ui.Views.History.SleepCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: SleepViewModel. Last night in the night hours from Settings: a verdict pill (CO₂ only), three numbers, a short tip and, when the night is only partly recorded, a note.
       A night without readings shows the title and one line. It takes the place of the typical day card in History for Day plus Night. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <controls:Card Padding="{StaticResource Space.Chart.Card}">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   Style="{StaticResource Text.SectionLabel}"
                   Text="&#xE708;" />
        <TextBlock Margin="{StaticResource Space.Inline}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.SectionLabel}"
                   Text="{Binding Title}" />
        <controls:Pill Margin="{StaticResource Space.Inline}"
                       VerticalAlignment="Center"
                       Content="{Binding VerdictText}"
                       Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}"
                       Zone="{Binding VerdictZone}" />
      </StackPanel>

      <Grid Margin="{StaticResource Space.Stats.Block}" Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:KeyValueCell Grid.Column="0" Label="{Binding FirstLabel}" Value="{Binding FirstValue}" />
        <controls:KeyValueCell Grid.Column="1" Label="{Binding PeakLabel}" Value="{Binding PeakValue}" />
        <controls:KeyValueCell Grid.Column="2" Label="{Binding DeepLabel}" Value="{Binding DeepValue}" />
      </Grid>

      <TextBlock Margin="{StaticResource Space.Stats.Block}"
                 Style="{StaticResource Text.Secondary}"
                 Text="{Binding Tip}"
                 TextWrapping="Wrap" />

      <TextBlock Margin="{StaticResource Space.Chart.Caption}"
                 FontWeight="SemiBold"
                 Style="{StaticResource Text.Secondary}"
                 Text="{Binding PartialNote}"
                 TextWrapping="Wrap"
                 Visibility="{Binding ShowPartialNote, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </controls:Card>
</UserControl>
