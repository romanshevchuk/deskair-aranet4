<UserControl x:Class="Deskair.App.Ui.Views.History.TypicalDayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: TypicalDayViewModel. The average CO2 for each hour of the day over the period, the worst three hours outlined. -->
  <controls:Card Padding="{StaticResource Space.Chart.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 Style="{StaticResource Text.SectionLabel}"
                 Text="{loc:T Chart_TypicalDay}" />

      <charts:TypicalDayChart x:Name="Chart"
                              Grid.Row="1"
                              Height="{StaticResource Size.TypicalDay.Chart.Height}"
                              Hours="{Binding Bars}"
                              NoDataText="{loc:T Chart_NoData}"
                              Unit="{loc:T Unit_Ppm}" />

      <TextBlock Grid.Row="2"
                 Margin="{StaticResource Space.Chart.Caption}"
                 MinHeight="{StaticResource Size.Chart.Readout.Height}"
                 Style="{StaticResource Text.Secondary}"
                 Text="{Binding Hover.Text, ElementName=Chart}" />
    </Grid>
  </controls:Card>
</UserControl>
