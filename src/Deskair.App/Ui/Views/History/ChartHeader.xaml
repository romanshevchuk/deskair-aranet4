<UserControl x:Class="Deskair.App.Ui.Views.History.ChartHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: ChartHeaderViewModel. The metric and what one bar stands for on the left; on the right the zone colours (CO₂) or how to read the chart, and the hatched "No data" swatch. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="Legend.Item" TargetType="{x:Type StackPanel}">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style x:Key="Legend.Dot" TargetType="{x:Type Ellipse}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <DrawingBrush x:Key="Legend.Hatch" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="{DynamicResource Card.Border.Hover.Brush}" Thickness="1.5" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="0,5" EndPoint="5,0" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <TextBlock FontSize="{StaticResource Font.Size.Title}"
                 FontWeight="{StaticResource Font.Weight.SemiBold}"
                 Foreground="{DynamicResource Text.Primary.Brush}"
                 Text="{Binding Title}" />
      <TextBlock FontSize="{StaticResource Font.Size.Title}"
                 Foreground="{DynamicResource Text.Secondary.Brush}"
                 Text="{Binding Subtitle, StringFormat=' · {0}'}" />
    </StackPanel>

    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">

      <!-- Day: the CO₂ line, the typical day and the night band. -->
      <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDayLegend, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDayCo2Legend, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Style="{StaticResource Legend.Item}">
            <Border Width="14" Height="4" Margin="0,0,5,0" VerticalAlignment="Center" CornerRadius="2">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{DynamicResource Zone.Good.Line.Color}" Offset="0" />
                  <GradientStop Color="{DynamicResource Zone.Elevated.Line.Color}" Offset="0.5" />
                  <GradientStop Color="{DynamicResource Zone.High.Line.Color}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Metric_Co2}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Style="{StaticResource Legend.Item}" Visibility="{Binding ShowDayTypicalLegend, Converter={StaticResource BoolToVisibility}}">
          <Border Width="14" Height="2" Margin="0,0,5,0" VerticalAlignment="Center" Background="{DynamicResource Text.Tertiary.Brush}" CornerRadius="1" Opacity="0.6" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T History_Legend_Typical}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Legend.Item}" Visibility="{Binding ShowComfortLegend, Converter={StaticResource BoolToVisibility}}">
          <Border Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" CornerRadius="3" Opacity="0.25">
            <Border.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Metric.Temperature.Brush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding LegendMetric}" Value="Humidity">
                    <Setter Property="Background" Value="{DynamicResource Metric.Humidity.Brush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T History_Legend_ComfortRange}" />
        </StackPanel>
        <StackPanel Style="{StaticResource Legend.Item}">
          <Border Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Background="{DynamicResource Grid.Brush}" CornerRadius="3" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T History_Legend_Night}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Margin="12,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding LegendText}" />

      <StackPanel Style="{StaticResource Legend.Item}" Visibility="{Binding ShowNoDataLegend, Converter={StaticResource BoolToVisibility}}">
        <Border Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Background="{StaticResource Legend.Hatch}" CornerRadius="3" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T History_Legend_NoData}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
