<UserControl x:Class="Deskair.App.Ui.Views.Live.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:live="clr-namespace:Deskair.App.Ui.Views.Live"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:markup="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: LiveViewModel (the tabs and the chart card). The 24 h ribbon shows for CO2 on 1h and 6h only. -->
  <controls:Card Padding="{StaticResource Space.Chart.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <live:MetricTabs Grid.Row="0" DataContext="{Binding Tabs}" />

      <TextBlock Grid.Row="1"
                 Margin="{StaticResource Space.Chart.Caption}"
                 Style="{StaticResource Text.Caption}"
                 markup:InlineMarkup.Text="{Binding ChartCard.SummaryText}"
                 Foreground="{DynamicResource Text.Secondary.Brush}" />

      <charts:LiveChart Grid.Row="2"
                        Margin="0,12,0,0"
                        Metric="{Binding Tabs.SelectedMetric}"
                        Points="{Binding ChartCard.Points}"
                        Unit="{Binding ChartCard.Unit}"
                        IdealMin="{Binding ChartCard.IdealMin}"
                        IdealMax="{Binding ChartCard.IdealMax}"
                        IdealLabel="{Binding ChartCard.IdealLabel}"
                        Window="{Binding ChartCard.Window}"
                        EndTime="{Binding ChartCard.EndTime}"
                        NowLabel="{loc:T Chart_Now}"
                        NoDataText="{loc:T Chart_NoData}" />

      <!-- The 24 h ribbon with its caption and hours, under a divider (prototype). Only for CO2 on 1h and 6h. -->
      <Border Grid.Row="3"
              Margin="0,12,0,0"
              BorderBrush="{DynamicResource Divider.Brush}"
              BorderThickness="0,1,0,0"
              Padding="0,8,0,0">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Tabs.ShowRibbon}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <charts:ZoneRibbon Caption="{loc:T Ribbon_Caption}"
                           EndTime="{Binding ChartCard.EndTime}"
                           Height="{StaticResource Size.Ribbon.Labelled.Height}"
                           Segments="{Binding ChartCard.RibbonSegments}" />
      </Border>
    </Grid>
  </controls:Card>
</UserControl>
