<UserControl x:Class="Deskair.App.Ui.Views.Live.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:vm="clr-namespace:Deskair.App.ViewModels.Live"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:markup="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: LiveViewModel (the metric and range choice, and the chart card). The title names the metric, which the hero and the mini cards choose
       (POL-06); the range stays here. The 24 h ribbon shows for CO2 on 1h and 6h only. -->
  <controls:Card Padding="{StaticResource Space.Chart.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Family.Display}"
                   Style="{StaticResource Text.Title}"
                   Text="{Binding ChartCard.Title}" />
        <controls:SegmentedControl Grid.Column="1"
                                   AutomationProperties.Name="{loc:T Range_Day}"
                                   SelectedValuePath="Tag"
                                   SelectedValue="{Binding Tabs.SelectedRange, Mode=TwoWay}">
          <ListBoxItem Content="{loc:T Range_1h}" Tag="{x:Static vm:LiveRange.OneHour}" />
          <ListBoxItem Content="{loc:T Range_6h}" Tag="{x:Static vm:LiveRange.SixHours}" />
          <ListBoxItem Content="{loc:T Range_24h}" Tag="{x:Static vm:LiveRange.TwentyFourHours}" />
        </controls:SegmentedControl>
      </Grid>

      <TextBlock Grid.Row="1"
                 Margin="{StaticResource Space.Chart.Caption}"
                 Style="{StaticResource Text.Caption}"
                 markup:InlineMarkup.Text="{Binding ChartCard.SummaryText}"
                 Foreground="{DynamicResource Text.Secondary.Brush}" />

      <charts:LiveChart Grid.Row="2"
                        Margin="0,12,0,0"
                        Metric="{Binding Tabs.SelectedMetric}"
                        Points="{Binding ChartCard.Points}"
                        Unit="{Binding ChartCard.Unit}"
                        IdealMin="{Binding ChartCard.IdealMin}"
                        IdealMax="{Binding ChartCard.IdealMax}"
                        IdealLabel="{Binding ChartCard.IdealLabel}"
                        ElevatedLineLabel="{Binding ChartCard.ElevatedLineLabel}"
                        HighLineLabel="{Binding ChartCard.HighLineLabel}"
                        Window="{Binding ChartCard.Window}"
                        EndTime="{Binding ChartCard.EndTime}"
                        NowLabel="{loc:T Chart_Now}"
                        NoDataText="{loc:T Chart_NoData}" />

      <!-- The 24 h ribbon with its caption and hours, under a divider (prototype). Only for CO2 on 1h and 6h. -->
      <Border Grid.Row="3"
              Margin="0,12,0,0"
              BorderBrush="{DynamicResource Divider.Brush}"
              BorderThickness="0,1,0,0"
              Padding="0,8,0,0">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Tabs.ShowRibbon}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <charts:ZoneRibbon Caption="{loc:T Ribbon_Caption}"
                           EndTime="{Binding ChartCard.EndTime}"
                           Height="{StaticResource Size.Ribbon.Labelled.Height}"
                           Segments="{Binding ChartCard.RibbonSegments}" />
      </Border>
    </Grid>
  </controls:Card>
</UserControl>
