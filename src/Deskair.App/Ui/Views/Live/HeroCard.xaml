<UserControl x:Class="Deskair.App.Ui.Views.Live.HeroCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:motion="clr-namespace:Deskair.App.Ui.Motion">
  <!-- DataContext: HeroViewModel. Zone glow, pill, value, trend, gauge, advice and the three stats. The four groups (title to trend, gauge, advice, stats)
       share the spare height through the star rows between them, so the card has no single gap above the stats (design-tokens.md "Hero padding"). -->
  <controls:Card Zone="{Binding Zone}" Padding="{StaticResource Space.Hero.Padding}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource Text.Body}"
                   FontSize="{StaticResource Font.Size.HeroTitle}"
                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Text.Primary.Brush}"
                   Text="{loc:T Metric_Co2}" />
        <controls:Pill HorizontalAlignment="Right" Zone="{Binding Zone}">
          <StackPanel Orientation="Horizontal">
            <controls:StatusDot Pulses="True" Zone="{Binding Zone}" VerticalAlignment="Center" />
            <TextBlock Margin="{StaticResource Space.Inline}" AutomationProperties.LiveSetting="Polite" Text="{Binding ZoneText}" />
          </StackPanel>
        </controls:Pill>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <TextBlock motion:FadeOnChange.IsEnabled="True" Style="{StaticResource Text.HeroValue}" Text="{Binding ValueText}" />
        <TextBlock Margin="{StaticResource Space.Hero.Unit}"
                   VerticalAlignment="Bottom"
                   Style="{StaticResource Text.Secondary}"
                   FontSize="{StaticResource Font.Size.Title}"
                   Text="{Binding UnitText}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource Space.Hero.Trend}">
        <StackPanel.Resources>
          <Style x:Key="Hero.TrendText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </StackPanel.Resources>
        <TextBlock Style="{StaticResource Hero.TrendText}">
          <TextBlock.Text>
            <Binding Path="Trend">
              <Binding.Converter>
                <controls:TrendArrowConverter />
              </Binding.Converter>
            </Binding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Hero.TrendText}" Text="{Binding TrendText}" />
        <TextBlock Margin="{StaticResource Space.Inline}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding TrendDetail}" />
      </StackPanel>

      <controls:Gauge Grid.Row="4"
                      Margin="{StaticResource Space.Hero.Gauge}"
                      Value="{Binding Co2Ppm}"
                      AutomationProperties.Name="{loc:T Metric_Co2}" />

      <controls:AdviceCard Grid.Row="6"
                           Margin="{StaticResource Space.Hero.Advice}"
                           Zone="{Binding Zone}"
                           Title="{Binding AdviceTitle}"
                           Text="{Binding AdviceText}" />

      <controls:StatTriple Grid.Row="8"
                           Margin="{StaticResource Space.Hero.Stats}"
                           ItemsSource="{Binding Stats}" />
    </Grid>
  </controls:Card>
</UserControl>
