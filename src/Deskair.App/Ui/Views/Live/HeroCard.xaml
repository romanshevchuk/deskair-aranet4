<UserControl x:Class="Deskair.App.Ui.Views.Live.HeroCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:trend="clr-namespace:Deskair.Domain.Analytics.Trend;assembly=Deskair.Domain">
  <!-- DataContext: HeroViewModel. Zone tint, pill, value, trend, gauge, advice and the three stats. -->
  <controls:Card Zone="{Binding Zone}" Padding="{StaticResource Space.Hero.Padding}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   FontWeight="{StaticResource Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Text.Primary.Brush}"
                   Text="{loc:T Metric_Co2}" />
        <controls:Pill HorizontalAlignment="Right" Zone="{Binding Zone}">
          <StackPanel Orientation="Horizontal">
            <controls:StatusDot Zone="{Binding Zone}" VerticalAlignment="Center" />
            <TextBlock Margin="{StaticResource Space.Inline}" Text="{Binding ZoneText}" />
          </StackPanel>
        </controls:Pill>
      </Grid>

      <StackPanel Grid.Row="1" Orientation="Horizontal">
        <TextBlock Style="{StaticResource Text.HeroValue}" Text="{Binding ValueText}" />
        <TextBlock Margin="{StaticResource Space.Hero.Unit}"
                   VerticalAlignment="Bottom"
                   Style="{StaticResource Text.Secondary}"
                   FontSize="{StaticResource Font.Size.Title}"
                   Text="{Binding UnitText}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{StaticResource Space.Hero.Trend}">
        <StackPanel.Resources>
          <Style x:Key="Hero.TrendText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Trend}" Value="{x:Static trend:TrendDirection.Falling}">
                <Setter Property="Foreground" Value="{DynamicResource Trend.Falling.Brush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Trend}" Value="{x:Static trend:TrendDirection.Rising}">
                <Setter Property="Foreground" Value="{DynamicResource Trend.Rising.Brush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Resources>
        <TextBlock Style="{StaticResource Hero.TrendText}">
          <TextBlock.Text>
            <Binding Path="Trend">
              <Binding.Converter>
                <controls:TrendArrowConverter />
              </Binding.Converter>
            </Binding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Margin="{StaticResource Space.Inline}" Style="{StaticResource Hero.TrendText}" Text="{Binding TrendText}" />
        <TextBlock Margin="{StaticResource Space.Inline}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding TrendDetail}" />
      </StackPanel>

      <controls:Gauge Grid.Row="3"
                      Margin="{StaticResource Space.Hero.Gauge}"
                      Value="{Binding Co2Ppm}"
                      AutomationProperties.Name="{loc:T Metric_Co2}" />

      <controls:AdviceCard Grid.Row="4"
                           Margin="{StaticResource Space.Hero.Advice}"
                           Zone="{Binding Zone}"
                           Title="{Binding AdviceTitle}"
                           Text="{Binding AdviceText}" />

      <controls:StatTriple Grid.Row="6"
                           Margin="{StaticResource Space.Hero.Stats}"
                           Zone="{Binding Zone}"
                           ItemsSource="{Binding Stats}" />
    </Grid>
  </controls:Card>
</UserControl>
