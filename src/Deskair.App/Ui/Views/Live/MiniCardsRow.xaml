<UserControl x:Class="Deskair.App.Ui.Views.Live.MiniCardsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:Deskair.App.Ui.Charts"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls">
  <!-- DataContext: LiveViewModel. Temperature, humidity and pressure, always in that order (CO₂ is the hero); clicking one shows it on the chart and gives it the accent ring. -->
  <ItemsControl Margin="{StaticResource Space.Mini.Row}"
                ItemsSource="{Binding MiniCards.Items}"
                Focusable="False">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <controls:MetricCard Margin="{StaticResource Space.Mini.Gap}"
                             Metric="{Binding Metric}"
                             Title="{Binding Title}"
                             Value="{Binding ValueText}"
                             Unit="{Binding UnitText}"
                             Subtitle="{Binding SubtitleText}"
                             Command="{Binding DataContext.Tabs.SelectMetricCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding Metric}"
                             IsSelected="{Binding IsSelected}"
                             AutomationProperties.Name="{Binding AccessibleName}">
          <charts:Sparkline Width="{StaticResource Size.Mini.Sparkline.Width}"
                            Height="{StaticResource Size.Mini.Sparkline.Height}"
                            Metric="{Binding Metric}"
                            Points="{Binding Sparkline}" />
        </controls:MetricCard>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
