<UserControl x:Class="Deskair.App.Ui.Views.Live.MetricTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:live="clr-namespace:Deskair.App.ViewModels.Live"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:metrics="clr-namespace:Deskair.Domain.Metrics;assembly=Deskair.Domain">
  <!-- DataContext: MetricTabsViewModel. The four metrics on the left, the three ranges on the right. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <controls:SegmentedControl Grid.Column="0"
                               AutomationProperties.Name="{loc:T Gallery_Section_MetricCard}"
                               SelectedValuePath="Tag"
                               SelectedValue="{Binding SelectedMetric, Mode=TwoWay}">
      <ListBoxItem Content="{loc:T Metric_Co2}" Tag="{x:Static metrics:Metric.Co2}" />
      <ListBoxItem Content="{loc:T Metric_Temperature}" Tag="{x:Static metrics:Metric.Temperature}" />
      <ListBoxItem Content="{loc:T Metric_Humidity}" Tag="{x:Static metrics:Metric.Humidity}" />
      <ListBoxItem Content="{loc:T Metric_Pressure}" Tag="{x:Static metrics:Metric.Pressure}" />
    </controls:SegmentedControl>

    <controls:SegmentedControl Grid.Column="2"
                               AutomationProperties.Name="{loc:T Range_Day}"
                               SelectedValuePath="Tag"
                               SelectedValue="{Binding SelectedRange, Mode=TwoWay}">
      <ListBoxItem Content="{loc:T Range_1h}" Tag="{x:Static live:LiveRange.OneHour}" />
      <ListBoxItem Content="{loc:T Range_6h}" Tag="{x:Static live:LiveRange.SixHours}" />
      <ListBoxItem Content="{loc:T Range_24h}" Tag="{x:Static live:LiveRange.TwentyFourHours}" />
    </controls:SegmentedControl>
  </Grid>
</UserControl>
