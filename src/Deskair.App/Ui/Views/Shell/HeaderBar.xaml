<UserControl x:Class="Deskair.App.Ui.Views.Shell.HeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:vm="clr-namespace:Deskair.App.ViewModels.Shell">
  <!-- DataContext: ShellViewModel. The logo and name on the left, the navigation in the middle, the room chip on the right.
       It is the window's title bar (WindowChrome, 52 px): the empty parts drag the window and double-click maximizes it; the tabs and the chip are marked clickable. The system draws the
       three caption buttons at the right edge (docs/plans/spike-s3-title-bar.md). -->
  <Grid Margin="{StaticResource Space.Header.Padding}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <controls:LogoRing Width="{StaticResource Size.Logo}"
                         Height="{StaticResource Size.Logo}"
                         Zone="{Binding Live.Hero.Zone}" />
      <TextBlock Margin="{StaticResource Space.Inline}"
                 VerticalAlignment="Center"
                 Style="{StaticResource Text.Title}"
                 Text="Deskair" />
    </StackPanel>

    <controls:SegmentedControl Grid.Column="1"
                               VerticalAlignment="Center"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               AutomationProperties.Name="{loc:T Nav_Main}"
                               SelectedValuePath="Tag"
                               SelectedValue="{Binding Section, Mode=TwoWay}">
      <ListBoxItem Content="{loc:T Nav_Live}" Tag="{x:Static vm:ShellSection.Live}" />
      <ListBoxItem Content="{loc:T Nav_History}" Tag="{x:Static vm:ShellSection.History}" />
      <ListBoxItem Content="{loc:T Nav_Settings}" Tag="{x:Static vm:ShellSection.Settings}" />
    </controls:SegmentedControl>

    <!-- No rooms yet (first run): no chip. -->
    <StackPanel Grid.Column="2"
                Margin="{StaticResource Space.Header.Chip}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                WindowChrome.IsHitTestVisibleInChrome="True"
                DataContext="{Binding Room}">
      <StackPanel.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <controls:RoomChip IsOpen="{Binding IsOpen, Mode=TwoWay}"
                         RoomName="{Binding SelectedRoom.Name}"
                         Zone="{Binding SelectedRoom.Zone}" />
      <controls:RoomMenu IsOpen="{Binding IsOpen, Mode=TwoWay}"
                         ItemsSource="{Binding Rooms}"
                         RoomChosenCommand="{Binding ChooseRoomCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
