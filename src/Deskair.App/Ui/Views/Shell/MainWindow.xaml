<Window x:Class="Deskair.App.Ui.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
        xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
        xmlns:shell="clr-namespace:Deskair.App.Ui.Views.Shell"
        xmlns:live="clr-namespace:Deskair.App.Ui.Views.Live"
        xmlns:history="clr-namespace:Deskair.App.Ui.Views.History"
        xmlns:onboarding="clr-namespace:Deskair.App.Ui.Views.Onboarding"
        xmlns:states="clr-namespace:Deskair.App.Ui.Views.States"
        xmlns:settings="clr-namespace:Deskair.App.Ui.Views.Settings"
        xmlns:vm="clr-namespace:Deskair.App.ViewModels.Shell"
        Style="{StaticResource Window.Base}"
        Title="Deskair"
        Width="1200"
        MinWidth="{StaticResource Size.Window.MinWidth}"
        MinHeight="{StaticResource Size.Window.MinHeight}"
        Height="728">
  <!-- The header is the title bar: a 52 px caption with the system's own caption buttons, so dragging, double-click, resizing and the snap layouts box on the maximize
       button all work as usual. BackdropService adds Mica on Windows 11. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="{StaticResource Size.Header.Height}"
                  CornerRadius="0"
                  GlassFrameThickness="0,1,0,0"
                  ResizeBorderThickness="{StaticResource Space.Window.ResizeBorder}"
                  UseAeroCaptionButtons="True" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate x:Key="Section.LiveScreen"><live:LiveView /></DataTemplate>
    <DataTemplate x:Key="Section.FirstRun"><onboarding:OnboardingView DataContext="{Binding Onboarding}" /></DataTemplate>
    <DataTemplate x:Key="Section.Offline"><states:OfflineView DataContext="{Binding Offline}" /></DataTemplate>
    <!-- Live; the welcome screen while there is no sensor; the offline view while the sensor cannot be reached (adding a sensor wins over both). -->
    <DataTemplate x:Key="Section.Live">
      <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
        <ContentControl.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="ContentTemplate" Value="{StaticResource Section.LiveScreen}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Connection.ShowOfflineView}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Section.Offline}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Connection.ShowFirstRunView}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Section.FirstRun}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Section.FirstRun}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="Section.History"><history:HistoryView DataContext="{Binding History}" /></DataTemplate>
    <DataTemplate x:Key="Section.Settings"><settings:SettingsView DataContext="{Binding Settings}" /></DataTemplate>

    <Style x:Key="Shell.Content" TargetType="{x:Type ContentControl}">
      <Setter Property="ContentTemplate" Value="{StaticResource Section.Live}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Section}" Value="{x:Static vm:ShellSection.History}">
          <Setter Property="ContentTemplate" Value="{StaticResource Section.History}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Section}" Value="{x:Static vm:ShellSection.Settings}">
          <Setter Property="ContentTemplate" Value="{StaticResource Section.Settings}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource Grid.Header.Height}" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{StaticResource Grid.Footer.Height}" />
    </Grid.RowDefinitions>

    <shell:HeaderBar Grid.Row="0" />
    <Grid Grid.Row="1" Margin="{StaticResource Space.Page.Padding}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Q27: the saved readings cannot be read (locked or damaged file, folder gone). Live keeps working. -->
      <controls:Banner Grid.Row="0"
                       Margin="{StaticResource Space.Banner.Below}"
                       ActionCommand="{Binding HistoryAccess.OpenFolderCommand}"
                       ActionText="{Binding HistoryAccess.ActionText}"
                       Message="{Binding HistoryAccess.Message}">
        <controls:Banner.Style>
          <Style TargetType="{x:Type controls:Banner}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HistoryAccess.IsUnreadable}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:Banner.Style>
      </controls:Banner>
      <ContentControl Grid.Row="1" Content="{Binding}" Style="{StaticResource Shell.Content}" />
    </Grid>
    <shell:FooterBar Grid.Row="2" />
  </Grid>
</Window>
