<UserControl x:Class="Deskair.App.Ui.Views.Shell.FooterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: ShellViewModel; the footer view model is its Footer. Status on the left; room, sensor id, signal and battery on the right. -->
  <Border Background="{DynamicResource Surface.Brush}"
          BorderBrush="{DynamicResource Divider.Brush}"
          BorderThickness="0,1,0,0"
          Padding="{StaticResource Space.Bar.Padding}"
          DataContext="{Binding Footer}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <controls:StatusDot Zone="{Binding DotZone}" VerticalAlignment="Center" />
        <TextBlock Margin="{StaticResource Space.Inline}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding StatusText}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding DetailText}" />
        <controls:BatteryIcon Margin="{StaticResource Space.Inline}" Percent="{Binding BatteryPercent}" VerticalAlignment="Center" />
        <TextBlock Margin="{StaticResource Space.Inline}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Secondary}"
                   Text="{Binding BatteryText}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
