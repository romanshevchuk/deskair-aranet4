<UserControl x:Class="Deskair.App.Ui.Views.States.EmptyHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: HistoryViewModel. Shown instead of the charts while nothing is stored for the room. The button opens the import in Settings. -->
  <controls:EmptyStateCard VerticalAlignment="Top"
                           Icon="&#xE81C;"
                           Message="{loc:T History_Empty_Text}"
                           Title="{loc:T History_Empty_Title}">
    <controls:PrimaryButton Command="{Binding ImportCommand}" Content="{loc:T History_Empty_Import}" />
  </controls:EmptyStateCard>
</UserControl>
