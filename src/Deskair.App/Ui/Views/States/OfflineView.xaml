<UserControl x:Class="Deskair.App.Ui.Views.States.OfflineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: OfflineViewModel. The whole Live area while the sensor cannot be reached: the likely cause, the last reading, what to try and the buttons.
       With Bluetooth off, "Turn on Bluetooth" comes first; Try again is always there. History stays available from the header. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <controls:EmptyStateCard VerticalAlignment="Top"
                           Icon="&#xE702;"
                           Message="{Binding Message}"
                           Title="{loc:T Offline_Title}">
    <StackPanel>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <controls:PrimaryButton Command="{Binding TurnOnBluetoothCommand}"
                                Content="{loc:T Offline_Bluetooth}"
                                Visibility="{Binding BluetoothOff, Converter={StaticResource BoolToVisibility}}" />
        <controls:SecondaryButton Margin="{StaticResource Space.Inline}" Command="{Binding RetryCommand}" Content="{loc:T Action_Retry}" />
      </StackPanel>

      <ItemsControl Margin="{StaticResource Space.Empty.Content}"
                    Focusable="False"
                    IsTabStop="False"
                    ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:EmptyStateCard>
</UserControl>
