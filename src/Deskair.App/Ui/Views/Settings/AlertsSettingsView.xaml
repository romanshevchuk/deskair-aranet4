<UserControl x:Class="Deskair.App.Ui.Views.Settings.AlertsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: AlertsSettingsViewModel. The switches save at once. The quiet hours times show while quiet hours are on, and a time is saved as soon as it reads as HH:mm.
       The "paused by Windows" row shows only while Windows Do Not Disturb holds the alerts. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <controls:SettingsCard Header="{loc:T Settings_Alerts}">
    <StackPanel>
      <controls:Banner Margin="0,0,0,8"
                       Message="{loc:T Settings_Alerts_PausedByWindows}"
                       Visibility="{Binding IsPausedByWindows, Converter={StaticResource BoolToVisibility}}" />
      <controls:SettingsRow Header="{loc:T Settings_Alerts_Enabled}" Description="{loc:T Settings_Alerts_EnabledHint}">
        <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_Alerts_Enabled}" IsChecked="{Binding AlertsEnabled, Mode=TwoWay}" />
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_Alerts_Elevated}">
        <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_Alerts_Elevated}" IsChecked="{Binding NotifyAtElevated, Mode=TwoWay}" />
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_Alerts_High}">
        <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_Alerts_High}" IsChecked="{Binding NotifyAtHigh, Mode=TwoWay}" />
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_QuietHours}" Description="{loc:T Settings_QuietHours_Hint}">
        <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_QuietHours}" IsChecked="{Binding QuietHoursEnabled, Mode=TwoWay}" />
      </controls:SettingsRow>
      <StackPanel Visibility="{Binding QuietHoursEnabled, Converter={StaticResource BoolToVisibility}}">
        <controls:SettingsRow Header="{loc:T Settings_QuietHours_From}">
          <controls:TextInput Width="{StaticResource Size.TimeField.Width}" MinWidth="0" Padding="4,3" HorizontalContentAlignment="Center"
                              AutomationProperties.Name="{loc:T Settings_QuietHours_From}"
                              Text="{Binding QuietHoursStart.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow>
        <TextBlock Style="{StaticResource Text.Caption}"
                   Text="{loc:T Settings_QuietHours_Invalid}"
                   Visibility="{Binding QuietHoursStart.IsInvalid, Converter={StaticResource BoolToVisibility}}" />
        <controls:SettingsRow Header="{loc:T Settings_QuietHours_To}">
          <controls:TextInput Width="{StaticResource Size.TimeField.Width}" MinWidth="0" Padding="4,3" HorizontalContentAlignment="Center"
                              AutomationProperties.Name="{loc:T Settings_QuietHours_To}"
                              Text="{Binding QuietHoursEnd.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:SettingsRow>
        <TextBlock Style="{StaticResource Text.Caption}"
                   Text="{loc:T Settings_QuietHours_Invalid}"
                   Visibility="{Binding QuietHoursEnd.IsInvalid, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </StackPanel>
  </controls:SettingsCard>
</UserControl>
