<UserControl x:Class="Deskair.App.Ui.Views.Settings.DevicesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: DevicesSettingsViewModel. One row per sensor with an editable room name (saved when the field is left), then Add, which opens the sensor search on Live. -->
  <controls:SettingsCard Header="{loc:T Settings_Devices}">
    <StackPanel>
      <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SettingsRow Header="{loc:T Settings_Devices_RoomName}" Description="{Binding Address}">
              <controls:TextInput Padding="8,3" AutomationProperties.Name="{loc:T Settings_Devices_RoomName}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
            </controls:SettingsRow>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <controls:SettingsRow Header="{loc:T Settings_Devices_None}">
        <controls:SettingsRow.Style>
          <Style BasedOn="{StaticResource {x:Type controls:SettingsRow}}" TargetType="{x:Type controls:SettingsRow}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasDevices}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </controls:SettingsRow.Style>
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_Devices_Add}" Description="{loc:T Settings_Devices_AddHint}">
        <controls:SecondaryButton Command="{Binding AddSensorCommand}" Content="{loc:T Action_Add}" />
      </controls:SettingsRow>
    </StackPanel>
  </controls:SettingsCard>
</UserControl>
