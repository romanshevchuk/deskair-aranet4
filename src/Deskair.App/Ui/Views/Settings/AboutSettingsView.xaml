<UserControl x:Class="Deskair.App.Ui.Views.Settings.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- No DataContext needed. The "unofficial" statement the Store policy asks for (store-packaging.md section 6). -->
  <controls:SettingsCard Header="{loc:T Settings_About}">
    <controls:SettingsRow Header="{loc:T Settings_About_Unofficial}" Description="{loc:T Settings_About_Text}" />
  </controls:SettingsCard>
</UserControl>
