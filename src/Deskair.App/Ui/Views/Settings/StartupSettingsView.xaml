<UserControl x:Class="Deskair.App.Ui.Views.Settings.StartupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: StartupSettingsViewModel. Start with Windows. "Keep in tray" and "Show CO2 on the tray icon" come with the tray. -->
  <controls:SettingsCard Header="{loc:T Settings_Startup}">
    <controls:SettingsRow Header="{loc:T Settings_Startup_Windows}" Description="{loc:T Settings_Startup_WindowsHint}">
      <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_Startup_Windows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
    </controls:SettingsRow>
  </controls:SettingsCard>
</UserControl>
