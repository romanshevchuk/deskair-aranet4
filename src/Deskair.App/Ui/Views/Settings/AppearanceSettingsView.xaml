<UserControl x:Class="Deskair.App.Ui.Views.Settings.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup"
             xmlns:metrics="clr-namespace:Deskair.Domain.Metrics;assembly=Deskair.Domain"
             xmlns:settings="clr-namespace:Deskair.Services.Settings;assembly=Deskair.Services">
  <!-- DataContext: AppearanceSettingsViewModel. Language, theme and temperature unit. A change is saved and applied at once. -->
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="Settings.Segments.Panel">
      <UniformGrid Rows="1" />
    </ItemsPanelTemplate>
  </UserControl.Resources>
  <controls:SettingsCard Header="{loc:T Settings_Appearance}">
    <StackPanel>
      <controls:SettingsRow Header="{loc:T Settings_Language}">
        <controls:SegmentedControl ItemsPanel="{StaticResource Settings.Segments.Panel}" MinWidth="{StaticResource Size.Segmented.SettingsMinWidth}" AutomationProperties.Name="{loc:T Settings_Language}"
                                   SelectedValue="{Binding Language, Mode=TwoWay}"
                                   SelectedValuePath="Tag">
          <ListBoxItem Content="{loc:T Language_System}" Tag="{x:Static settings:LanguageChoice.System}" />
          <ListBoxItem Content="{loc:T Language_English}" Tag="{x:Static settings:LanguageChoice.English}" />
          <ListBoxItem Content="{loc:T Language_Ukrainian}" Tag="{x:Static settings:LanguageChoice.Ukrainian}" />
        </controls:SegmentedControl>
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_Theme}">
        <controls:SegmentedControl ItemsPanel="{StaticResource Settings.Segments.Panel}" MinWidth="{StaticResource Size.Segmented.SettingsMinWidth}" AutomationProperties.Name="{loc:T Settings_Theme}"
                                   SelectedValue="{Binding Theme, Mode=TwoWay}"
                                   SelectedValuePath="Tag">
          <ListBoxItem Content="{loc:T Theme_System}" Tag="{x:Static settings:ThemeChoice.System}" />
          <ListBoxItem Content="{loc:T Theme_Light}" Tag="{x:Static settings:ThemeChoice.Light}" />
          <ListBoxItem Content="{loc:T Theme_Dark}" Tag="{x:Static settings:ThemeChoice.Dark}" />
        </controls:SegmentedControl>
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_Unit}">
        <controls:SegmentedControl ItemsPanel="{StaticResource Settings.Segments.Panel}" MinWidth="{StaticResource Size.Segmented.SettingsMinWidth}" AutomationProperties.Name="{loc:T Settings_Unit}"
                                   SelectedValue="{Binding TemperatureUnit, Mode=TwoWay}"
                                   SelectedValuePath="Tag">
          <ListBoxItem Content="{loc:T Unit_Celsius}" Tag="{x:Static metrics:TemperatureUnit.Celsius}" />
          <ListBoxItem Content="{loc:T Unit_Fahrenheit}" Tag="{x:Static metrics:TemperatureUnit.Fahrenheit}" />
        </controls:SegmentedControl>
      </controls:SettingsRow>
      <controls:SettingsRow Header="{loc:T Settings_TrayValue}" Description="{loc:T Settings_TrayValue_Hint}">
        <controls:ToggleSwitch AutomationProperties.Name="{loc:T Settings_TrayValue}" IsChecked="{Binding ShowValueOnTrayIcon, Mode=TwoWay}" />
      </controls:SettingsRow>
    </StackPanel>
  </controls:SettingsCard>
</UserControl>
