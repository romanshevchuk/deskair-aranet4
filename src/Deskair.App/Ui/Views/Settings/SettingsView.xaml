<UserControl x:Class="Deskair.App.Ui.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Deskair.App.Ui.Views.Settings">
  <!-- DataContext: SettingsViewModel. One centred column, at most 720 px: Appearance and units, Alerts, Devices, Data and storage, Sleep, Start-up (the Windows 11 Settings pattern). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Stretch with a maximum width: WPF centres the column once the window is wider than 720 px. -->
    <StackPanel MaxWidth="{StaticResource Size.Settings.MaxWidth}">
      <settings:AppearanceSettingsView Margin="0,0,0,16" DataContext="{Binding Appearance}" />
      <settings:AlertsSettingsView Margin="0,0,0,16" DataContext="{Binding Alerts}" />
      <settings:DevicesSettingsView Margin="0,0,0,16" DataContext="{Binding Devices}" />
      <settings:DataSettingsView Margin="0,0,0,16" DataContext="{Binding Data}" />
      <settings:SleepSettingsView Margin="0,0,0,16" DataContext="{Binding Sleep}" />
      <settings:StartupSettingsView DataContext="{Binding Startup}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
