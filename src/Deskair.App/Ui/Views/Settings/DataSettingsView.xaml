<UserControl x:Class="Deskair.App.Ui.Views.Settings.DataSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Deskair.App.Ui.Controls"
             xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <!-- DataContext: DataSettingsViewModel. The data folder (Open, Change; a new folder is used after a restart and the files are not copied), import from the phone app (choose a file, see what it holds, then confirm) and export to CSV.
       The result of an import or export shows as one line under its row. -->

  <controls:SettingsCard Header="{loc:T Settings_Data}">
    <StackPanel>
      <controls:SettingsRow Header="{loc:T Settings_Data_Folder}" Description="{Binding DataFolder}">
        <StackPanel Orientation="Horizontal">
          <controls:SecondaryButton Command="{Binding OpenFolderCommand}" Content="{loc:T Settings_Data_OpenFolder}" />
          <controls:SecondaryButton Margin="{StaticResource Space.Inline}" Command="{Binding ChangeFolderCommand}" Content="{loc:T Settings_Data_ChangeFolder}" />
        </StackPanel>
      </controls:SettingsRow>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Space.SettingsRow.Caption}" TextWrapping="Wrap" Text="{Binding FolderNote}" Visibility="{Binding HasFolderNote, Converter={StaticResource BoolToVisibility}}" />

      <controls:SettingsRow Header="{loc:T Settings_Data_Import}" Description="{loc:T Settings_Data_ImportHint}">
        <controls:SecondaryButton Command="{Binding Import.ChooseFileCommand}" Content="{loc:T Settings_Data_ChooseFile}" />
      </controls:SettingsRow>
      <controls:SettingsRow Description="{Binding Import.PreviewText}" Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <controls:SecondaryButton Command="{Binding Import.CancelCommand}" Content="{loc:T Action_Cancel}" />
          <controls:PrimaryButton Margin="{StaticResource Space.Inline}" Command="{Binding Import.ConfirmCommand}" Content="{loc:T Action_Import}" />
        </StackPanel>
      </controls:SettingsRow>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Space.SettingsRow.Caption}" TextWrapping="Wrap" Text="{Binding Import.StatusText}" Visibility="{Binding Import.HasStatus, Converter={StaticResource BoolToVisibility}}" />

      <controls:SettingsRow Header="{loc:T Settings_Data_Export}" Description="{loc:T Settings_Data_ExportHint}">
        <controls:SecondaryButton Command="{Binding Export.ExportCommand}" Content="{loc:T Action_Export}" />
      </controls:SettingsRow>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Space.SettingsRow.Caption}" TextWrapping="Wrap" Text="{Binding Export.StatusText}" Visibility="{Binding Export.HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </controls:SettingsCard>
</UserControl>
