<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls"
                    xmlns:live="clr-namespace:Deskair.App.ViewModels.Live">
  <!-- Three stats in equal columns with a neutral divider between them (POL-01; the hero is white, so the zone-tinted rule on top is gone). -->
  <Style TargetType="{x:Type local:StatTriple}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <local:StatTriplePanel DividerBrush="{DynamicResource Divider.Brush}" Gap="{DynamicResource Size.Stats.DividerGap}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate DataType="{x:Type live:StatItem}">
          <local:KeyValueCell Label="{Binding Label}" Value="{Binding Value}" ValueFirst="True" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:StatTriple}">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
