<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls"
                    xmlns:loc="clr-namespace:Deskair.App.Ui.Markup">
  <Style TargetType="{x:Type local:Banner}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Banner}">
          <Border Background="{DynamicResource Zone.Elevated.AdviceBg.Brush}"
                  BorderBrush="{DynamicResource Zone.Elevated.AdviceBorder.Brush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Banner}"
                  Padding="{DynamicResource Space.Banner.Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{DynamicResource Text.Secondary}"
                         Foreground="{DynamicResource Text.Primary.Brush}"
                         VerticalAlignment="Center"
                         Text="{TemplateBinding Message}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <local:SecondaryButton x:Name="Action"
                                       Margin="{DynamicResource Space.Banner.Buttons}"
                                       Padding="{DynamicResource Space.Button.Small.Padding}"
                                       Background="Transparent"
                                       BorderBrush="{DynamicResource Zone.Elevated.AdviceBorder.Brush}"
                                       Command="{TemplateBinding ActionCommand}"
                                       Content="{TemplateBinding ActionText}" />
                <local:SecondaryButton x:Name="Dismiss"
                                       Margin="{DynamicResource Space.Banner.Buttons}"
                                       Padding="{DynamicResource Space.Button.Small.Padding}"
                                       Background="Transparent"
                                       BorderBrush="{DynamicResource Zone.Elevated.AdviceBorder.Brush}"
                                       AutomationProperties.Name="{loc:T Action_Dismiss}"
                                       Command="{TemplateBinding DismissCommand}"
                                       Content="{loc:T Action_Dismiss}" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ActionCommand" Value="{x:Null}">
              <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="DismissCommand" Value="{x:Null}">
              <Setter TargetName="Dismiss" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
