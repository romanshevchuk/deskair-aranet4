<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:AdviceCard}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AdviceCard}">
          <Border x:Name="Panel"
                  Background="{DynamicResource Insight.Bg.Brush}"
                  BorderBrush="{DynamicResource Border.Brush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Advice}"
                  Padding="{DynamicResource Space.Advice.Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Icon badge: the zone is also conveyed by the icon, not by colour alone. -->
              <Grid x:Name="Badge"
                    Visibility="Collapsed"
                    Width="{DynamicResource Size.Advice.Badge}"
                    Height="{DynamicResource Size.Advice.Badge}"
                    Margin="{DynamicResource Space.Advice.Badge}"
                    VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource Advice.IconBadge.Brush}" />
                <Viewbox Width="{DynamicResource Size.Advice.Icon}" Height="{DynamicResource Size.Advice.Icon}">
                  <Canvas Width="18" Height="18">
                    <Canvas x:Name="GoodIcon" Visibility="Collapsed">
                      <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="{DynamicResource Zone.Good.AdviceIcon.Brush}" StrokeThickness="1.6" />
                      <Path Data="M5.8,9.2 L8,11.4 L12.2,6.8" Stroke="{DynamicResource Zone.Good.AdviceIcon.Brush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                    <Canvas x:Name="ElevatedIcon" Visibility="Collapsed">
                      <Rectangle Canvas.Left="2.5" Canvas.Top="2.5" Width="13" Height="13" RadiusX="2" RadiusY="2" Stroke="{DynamicResource Zone.Elevated.AdviceIcon.Brush}" StrokeThickness="1.6" />
                      <Path Data="M9,2.5 L9,15.5 M2.5,9 L15.5,9" Stroke="{DynamicResource Zone.Elevated.AdviceIcon.Brush}" StrokeThickness="1.6" />
                    </Canvas>
                    <Canvas x:Name="HighIcon" Visibility="Collapsed">
                      <Path Data="M9,2.6 L16,15 L2,15 Z" Stroke="{DynamicResource Zone.High.AdviceIcon.Brush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                      <Path Data="M9,7 L9,10.5 M9,12.4 L9,12.5" Stroke="{DynamicResource Zone.High.AdviceIcon.Brush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                  </Canvas>
                </Viewbox>
              </Grid>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource Text.Body}"
                           FontWeight="{DynamicResource Font.Weight.SemiBold}"
                           Text="{TemplateBinding Title}" />
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{TemplateBinding Text}" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Zone" Value="Good">
              <Setter TargetName="Panel" Property="Background" Value="{DynamicResource Zone.Good.AdviceBg.Brush}" />
              <Setter TargetName="Panel" Property="BorderBrush" Value="{DynamicResource Zone.Good.AdviceBorder.Brush}" />
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="GoodIcon" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Zone" Value="Elevated">
              <Setter TargetName="Panel" Property="Background" Value="{DynamicResource Zone.Elevated.AdviceBg.Brush}" />
              <Setter TargetName="Panel" Property="BorderBrush" Value="{DynamicResource Zone.Elevated.AdviceBorder.Brush}" />
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="ElevatedIcon" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Zone" Value="High">
              <Setter TargetName="Panel" Property="Background" Value="{DynamicResource Zone.High.AdviceBg.Brush}" />
              <Setter TargetName="Panel" Property="BorderBrush" Value="{DynamicResource Zone.High.AdviceBorder.Brush}" />
              <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
              <Setter TargetName="HighIcon" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
