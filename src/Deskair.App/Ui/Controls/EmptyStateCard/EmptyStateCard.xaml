<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:EmptyStateCard}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EmptyStateCard}">
          <local:Card Padding="{DynamicResource Space.Empty.Padding}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="{DynamicResource Size.Empty.TextWidth}">
              <ContentPresenter x:Name="IconHost"
                                HorizontalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                TextElement.FontSize="{DynamicResource Size.Empty.Icon}"
                                TextElement.Foreground="{DynamicResource Text.Secondary.Brush}" />
              <TextBlock Margin="{DynamicResource Space.Empty.Title}"
                         HorizontalAlignment="Center"
                         FontSize="{DynamicResource Font.Size.Title}"
                         FontWeight="{DynamicResource Font.Weight.SemiBold}"
                         Foreground="{DynamicResource Text.Primary.Brush}"
                         Text="{TemplateBinding Title}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Margin="{DynamicResource Space.Empty.Message}"
                         HorizontalAlignment="Center"
                         FontSize="{DynamicResource Font.Size.Secondary}"
                         Foreground="{DynamicResource Text.Secondary.Brush}"
                         Text="{TemplateBinding Message}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <ContentPresenter Margin="{DynamicResource Space.Empty.Content}" HorizontalAlignment="Center" />
            </StackPanel>
          </local:Card>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
