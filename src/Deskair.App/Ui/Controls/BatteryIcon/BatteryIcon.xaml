<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:BatteryIcon}">
    <Setter Property="Width" Value="{DynamicResource Size.Battery.Width}" />
    <Setter Property="Height" Value="{DynamicResource Size.Battery.Height}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:BatteryIcon}">
          <Canvas Width="26" Height="12">
            <!-- Outline and terminal in the text colour at 60 % opacity (glyph geometry, like the advice icons). -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="23" Height="12"
                    BorderBrush="{TemplateBinding Foreground}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Battery}" Opacity="0.6" />
            <Border Canvas.Left="24" Canvas.Top="3.5" Width="2" Height="5"
                    Background="{TemplateBinding Foreground}" CornerRadius="0,1,1,0" Opacity="0.6" />
            <Border x:Name="Fill" Canvas.Left="2" Canvas.Top="2" Height="8"
                    Width="{Binding FillWidth, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{DynamicResource Zone.Good.Segment.Brush}" CornerRadius="1.5" Visibility="Collapsed" />
          </Canvas>
          <ControlTemplate.Triggers>
            <Trigger Property="Level" Value="Good">
              <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Level" Value="Low">
              <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Zone.Elevated.Segment.Brush}" />
            </Trigger>
            <Trigger Property="Level" Value="Critical">
              <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Zone.High.Segment.Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
