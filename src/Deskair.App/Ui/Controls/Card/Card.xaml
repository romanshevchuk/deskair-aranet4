<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:Card}">
    <Setter Property="Background" Value="{DynamicResource Surface.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:Card}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius.Card}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Zone" Value="Good">
        <Setter Property="Background" Value="{DynamicResource Zone.Good.CardBg.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zone.Good.CardBorder.Brush}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Trigger>
      <Trigger Property="Zone" Value="Elevated">
        <Setter Property="Background" Value="{DynamicResource Zone.Elevated.CardBg.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zone.Elevated.CardBorder.Brush}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Trigger>
      <Trigger Property="Zone" Value="High">
        <Setter Property="Background" Value="{DynamicResource Zone.High.CardBg.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Zone.High.CardBorder.Brush}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
