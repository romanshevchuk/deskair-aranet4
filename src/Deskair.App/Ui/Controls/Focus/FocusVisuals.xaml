<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared keyboard focus ring (accessibility: every control has a visible focus ring). -->
  <Style x:Key="Focus.Ring.Pill">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3"
                  BorderBrush="{DynamicResource Focus.Ring.Brush}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Pill}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Ring.Segment">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Focus.Ring.Brush}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Segment}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Focus.Ring.Button">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{DynamicResource Focus.Ring.Brush}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Button}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Ring.Card">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{DynamicResource Focus.Ring.Brush}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Card}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Ring.Chip">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{DynamicResource Focus.Ring.Brush}"
                  BorderThickness="2"
                  CornerRadius="{DynamicResource Radius.Chip}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
