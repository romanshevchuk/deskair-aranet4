<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <!-- 32 × 32, radius 8, transparent until hovered (the caption button hover tint works in both themes); disabled fades to 35 %. -->
  <Style TargetType="{x:Type local:IconButton}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
    <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring.Button}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:IconButton}">
          <Border x:Name="Frame" Background="Transparent" CornerRadius="{DynamicResource Radius.Segment}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{TemplateBinding Foreground}"
                       Text="{TemplateBinding Glyph}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Caption.Hover.Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
