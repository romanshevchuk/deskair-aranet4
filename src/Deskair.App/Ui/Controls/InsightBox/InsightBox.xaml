<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls"
                    xmlns:markup="clr-namespace:Deskair.App.Ui.Markup">
  <Style TargetType="{x:Type local:InsightBox}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Strong2.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Secondary}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:InsightBox}">
          <Border x:Name="Frame"
                  Background="{DynamicResource Insight.Bg.Brush}"
                  BorderBrush="{DynamicResource Divider.Brush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Advice}"
                  Padding="{DynamicResource Space.Insight.Padding}">
            <TextBlock FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       LineHeight="18"
                       markup:InlineMarkup.Text="{TemplateBinding Content}"
                       TextWrapping="Wrap" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Zone" Value="Good">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Zone.Good.AdviceBg.Brush}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Zone.Good.AdviceBorder.Brush}" />
            </Trigger>
            <Trigger Property="Zone" Value="Elevated">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Zone.Elevated.AdviceBg.Brush}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Zone.Elevated.AdviceBorder.Brush}" />
            </Trigger>
            <Trigger Property="Zone" Value="High">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Zone.High.AdviceBg.Brush}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Zone.High.AdviceBorder.Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="HasContent" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
