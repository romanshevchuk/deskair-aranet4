       Edge  : No header hides the header line.
       Done  : The gallery shows it in all states, light and dark, English and Ukrainian; build and tests pass. -->
  <Style TargetType="{x:Type local:SettingsCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SettingsCard}">
          <Border />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
