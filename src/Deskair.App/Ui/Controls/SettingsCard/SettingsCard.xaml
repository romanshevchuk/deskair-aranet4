<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:SettingsCard}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SettingsCard}">
          <Grid>
          <Border Background="{DynamicResource Surface.Brush}"
                  CornerRadius="{DynamicResource Radius.Card}"
                  Effect="{DynamicResource Shadow.Card}"
                  IsHitTestVisible="False" />
          <Border Background="{DynamicResource Surface.Brush}"
                  BorderBrush="{DynamicResource Card.Border.Brush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Card}"
                  Padding="{DynamicResource Space.SettingsCard.Padding}">
            <StackPanel>
              <TextBlock x:Name="HeaderText"
                         Margin="{DynamicResource Space.SettingsCard.Header}"
                         Style="{DynamicResource Text.SectionLabel}"
                         Text="{TemplateBinding Header}" />
              <!-- The first row's divider sits 1 px above the clip edge, so it is not drawn. -->
              <Border ClipToBounds="True">
                <ContentPresenter Margin="0,-1,0,0" />
              </Border>
            </StackPanel>
          </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
