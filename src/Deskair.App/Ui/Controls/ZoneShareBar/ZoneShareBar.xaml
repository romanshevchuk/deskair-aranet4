<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:ZoneShareBar}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:ZoneShareBar}">
          <Border x:Name="PART_Track"
                  Height="{DynamicResource Size.ZoneShare.Height}"
                  Background="{DynamicResource Segment.Bg.Brush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PART_Good" Width="0*" />
                <ColumnDefinition x:Name="PART_Elevated" Width="0*" />
                <ColumnDefinition x:Name="PART_High" Width="0*" />
                <ColumnDefinition x:Name="PART_Rest" Width="1*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource Zone.Good.Segment.Brush}" />
              <Border Grid.Column="1" Background="{DynamicResource Zone.Elevated.Segment.Brush}" />
              <Border Grid.Column="2" Background="{DynamicResource Zone.High.Segment.Brush}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
