<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Deskair.App.Ui.Controls">
  <Style TargetType="{x:Type local:StatusDot}">
    <Setter Property="Width" Value="{DynamicResource Size.StatusDot}" />
    <Setter Property="Height" Value="{DynamicResource Size.StatusDot}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:StatusDot}">
          <Ellipse x:Name="Dot" Fill="{DynamicResource Text.Tertiary.Brush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="Zone" Value="Good">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Zone.Good.Dot.Brush}" />
            </Trigger>
            <Trigger Property="Zone" Value="Elevated">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Zone.Elevated.Dot.Brush}" />
            </Trigger>
            <Trigger Property="Zone" Value="High">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Zone.High.Dot.Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
