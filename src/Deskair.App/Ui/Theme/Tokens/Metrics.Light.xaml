<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Metric tokens, Light (docs/design/design-tokens.md) -->
  <Color x:Key="Metric.Co2.Color">#5C6B77</Color>
  <SolidColorBrush x:Key="Metric.Co2.Brush" Color="{StaticResource Metric.Co2.Color}" />
  <Color x:Key="Metric.Temperature.Color">#E07A1F</Color>
  <SolidColorBrush x:Key="Metric.Temperature.Brush" Color="{StaticResource Metric.Temperature.Color}" />
  <Color x:Key="Metric.Humidity.Color">#2563C9</Color>
  <SolidColorBrush x:Key="Metric.Humidity.Brush" Color="{StaticResource Metric.Humidity.Color}" />
  <Color x:Key="Metric.Pressure.Color">#6D4FC2</Color>
  <SolidColorBrush x:Key="Metric.Pressure.Brush" Color="{StaticResource Metric.Pressure.Color}" />
</ResourceDictionary>
