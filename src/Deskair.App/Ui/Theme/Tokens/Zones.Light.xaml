  <Color x:Key="Heat.Cool1.Color">#B5CDEE</Color>
  <SolidColorBrush x:Key="Heat.Cool1.Brush" Color="{StaticResource Heat.Cool1.Color}" />
  <Color x:Key="Heat.Comfort.Color">#E6EAED</Color>
