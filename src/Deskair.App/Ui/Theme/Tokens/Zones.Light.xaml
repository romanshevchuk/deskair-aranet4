  <Color x:Key="Zone.Elevated.PillText.Color">#7A4800</Color>
  <SolidColorBrush x:Key="Zone.Elevated.PillText.Brush" Color="{StaticResource Zone.Elevated.PillText.Color}" />
  <Color x:Key="Zone.Elevated.Dot.Color">#D4961A</Color>
  <SolidColorBrush x:Key="Zone.Elevated.Dot.Brush" Color="{StaticResource Zone.Elevated.Dot.Color}" />
  <Color x:Key="Zone.Elevated.AdviceBg.Color">#FBEFD0</Color>
  <SolidColorBrush x:Key="Zone.Elevated.AdviceBg.Brush" Color="{StaticResource Zone.Elevated.AdviceBg.Color}" />
  <Color x:Key="Zone.Elevated.AdviceBorder.Color">#EFD596</Color>
