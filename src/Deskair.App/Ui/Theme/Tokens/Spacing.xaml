  <GridLength x:Key="Grid.Header.Height">52</GridLength>
  <GridLength x:Key="Grid.Footer.Height">40</GridLength>
  <sys:Double x:Key="Size.Footer.Height">40</sys:Double>
  <Thickness x:Key="Space.Page.Padding">24,8,24,20</Thickness>
  <Thickness x:Key="Space.Bar.Padding">24,0,24,0</Thickness>
  <Thickness x:Key="Space.Inline">8,0,0,0</Thickness>
  <Thickness x:Key="Space.Inline.Wide">24,0,0,0</Thickness>
  <Thickness x:Key="Space.Item">0,0,16,16</Thickness>
  <Thickness x:Key="Space.SectionLabel">0,0,0,8</Thickness>
  <Thickness x:Key="Space.Card.Padding">16</Thickness>
  <sys:Double x:Key="Space.Card.Gap">16</sys:Double>
  <!-- Confirmed by the prototype: top 22, sides 24, bottom 20. -->
  <Thickness x:Key="Space.Hero.Padding">24,22,24,20</Thickness>
  <sys:Double x:Key="Size.Live.MiniRow.Height">132</sys:Double>
  <sys:Double x:Key="Size.History.Toolbar.Height">40</sys:Double>
  <sys:Double x:Key="Size.History.Stats.Width">360</sys:Double>
