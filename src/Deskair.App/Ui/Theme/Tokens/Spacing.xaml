  <sys:Double x:Key="Size.Chart.Readout.Height">20</sys:Double>
  <Thickness x:Key="Space.Input.Padding">14,6,14,6</Thickness>
  <sys:Double x:Key="Size.Input.MinWidth">200</sys:Double>

