  <sys:Double x:Key="Size.Toggle.Knob">18</sys:Double>
  <sys:Double x:Key="Size.StatusDot">8</sys:Double>
  <Thickness x:Key="Space.Toggle.KnobOff">2,0,0,0</Thickness>
  <Thickness x:Key="Space.Toggle.KnobOn">18,0,0,0</Thickness>
  <Thickness x:Key="Space.Toggle.Label">10,0,0,0</Thickness>
  <Thickness x:Key="Space.Segment.Padding">3</Thickness>
  <Thickness x:Key="Space.Segment.Item.Padding">14,5,14,5</Thickness>
  <Thickness x:Key="Space.Pill.Padding">9,4,11,4</Thickness>

  <Duration x:Key="Motion.Toggle">0:0:0.15</Duration>
</ResourceDictionary>
