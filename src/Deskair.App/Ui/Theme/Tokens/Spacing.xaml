  <Thickness x:Key="Space.History.Chart.Card">22,16,22,8</Thickness>
  <Thickness x:Key="Space.TypicalDay.Card">22,14,22,6</Thickness>
  <Thickness x:Key="Space.Stats.Card">20,16,20,16</Thickness>
  <Thickness x:Key="Space.Chart.Caption">0,10,0,0</Thickness>
