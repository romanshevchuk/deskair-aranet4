<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Base styles: window and text roles. Everything uses DynamicResource tokens. -->
  <Style x:Key="Window.Base" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource Window.Bg.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Secondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
  </Style>

  <Style x:Key="Text.SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
  </Style>

  <Style x:Key="Text.Number" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Display values are proportional (D-0020): tabular figures gave each "1" a full digit width and left gaps in "1151". -->
  <Style x:Key="Text.HeroValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="Typography.NumeralAlignment" Value="Proportional" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Hero}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.Hero}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Light}" />
  </Style>

  <Style x:Key="Text.MiniValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.MiniValue}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.MiniValue}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
  </Style>

  <Style x:Key="Text.HistoryAverage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="Typography.NumeralAlignment" Value="Proportional" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.HistoryAverage}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.HistoryAverage}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Light}" />
  </Style>

  <!-- Scroll bars (POL-26): a thin rounded thumb on no track, no arrows, in the card-border-hover grey (text.tertiary while hovered or dragged), so the dark theme has no light strip. -->
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border x:Name="Bar"
                              Margin="2,0"
                              Background="{DynamicResource Card.Border.Hover.Brush}"
                              CornerRadius="3" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Text.Tertiary.Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Text.Tertiary.Brush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
