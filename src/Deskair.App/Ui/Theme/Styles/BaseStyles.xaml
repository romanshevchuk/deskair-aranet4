<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Base styles: window and text roles. Everything uses DynamicResource tokens. -->
  <Style x:Key="Window.Base" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource Window.Bg.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Secondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
  </Style>

  <Style x:Key="Text.SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary.Brush}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
  </Style>

  <Style x:Key="Text.Number" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style x:Key="Text.HeroValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Hero}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.Hero}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Light}" />
  </Style>

  <Style x:Key="Text.MiniValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.MiniValue}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.MiniValue}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
  </Style>

  <Style x:Key="Text.HistoryAverage" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Number}">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.HistoryAverage}" />
    <Setter Property="LineHeight" Value="{DynamicResource Font.Size.HistoryAverage}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Light}" />
  </Style>
</ResourceDictionary>
