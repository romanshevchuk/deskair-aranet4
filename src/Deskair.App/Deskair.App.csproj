<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Deskair.App.Program</StartupObject>
    <!-- The app ships English and Ukrainian only; the framework's other languages would add about 8 MB to the package. -->
    <SatelliteResourceLanguages>en;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main starts the app, so App.xaml is a page, not the application definition. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deskair.Domain\Deskair.Domain.csproj" />
    <ProjectReference Include="..\Deskair.Services\Deskair.Services.csproj" />
    <ProjectReference Include="..\Deskair.Sensors\Deskair.Sensors.csproj" />
    <ProjectReference Include="..\Deskair.Storage\Deskair.Storage.csproj" />
  </ItemGroup>

</Project>
